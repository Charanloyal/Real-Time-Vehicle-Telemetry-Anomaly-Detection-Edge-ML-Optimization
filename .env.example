# Copy to .env and adjust. Never commit .env.
# The application reads these from the process environment (e.g. set in PowerShell or docker run -e).

# HTTP port for the API (cloud platforms usually inject PORT).
PORT=8000
# Optional: alternative config file and model directory.
# VTAD_CONFIG=configs/config.yaml
# VTAD_MODEL_DIR=artifacts/models
LOG_LEVEL=INFO
# Optional: cap model inference threads (recommended: 1 on small shared-CPU hosts such as Render free).
# VTAD_INFERENCE_THREADS=1
# Optional: serve with ONNX Runtime instead of scikit-learn / XGBoost (native | onnx).
# VTAD_RUNTIME=onnx
# Optional, for the Spark engine: Java 17+ runtime location.
# JAVA_HOME=C:\path\to\jdk-17
# Windows only, for Spark file streaming: Hadoop winutils location (see README).
# HADOOP_HOME=C:\path\to\hadoop
